# RoboGuard Pro Environment Configuration

# ==================== DATABASE ====================
MONGODB_URI=mongodb://mongodb:27017/roboguard
REDIS_URL=redis://redis:6379

# ==================== SERVICES ====================
# Backend (Node.js)
PORT=8000
NODE_ENV=development

# AI Engine (Python)
AI_ENGINE_URL=http://ai-engine:8001

# Core Services (Rust)
CORE_SERVICES_URL=http://core-services:8080

# Fleet Services (Go)
FLEET_SERVICES_URL=http://fleet-services:8090

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ==================== SECURITY ====================
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# ==================== AI PROVIDERS ====================
# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== AUTONOMOUS FRAMEWORK ====================
FRAMEWORK_MODE=autonomous
EVOLUTION_RATE=aggressive
LEARNING_ENABLED=true
AUTO_DEPLOYMENT=true
