# CoachHub Pro Environment Configuration

# ==================== DATABASE ====================
MONGODB_URI=mongodb://admin:coachhub_admin_pass@mongodb:27017/coachhub?authSource=admin
REDIS_URL=redis://redis:6379

# ==================== SERVICES ====================
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
AI_ENGINE_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:8080
SESSION_SERVICE_URL=http://localhost:8090

# ==================== SECURITY ====================
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# ==================== STRIPE PAYMENTS ====================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==================== AI PROVIDERS ====================
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ==================== VIDEO (Optional) ====================
AGORA_APP_ID=your-agora-app-id-here
AGORA_APP_CERTIFICATE=your-agora-certificate-here
